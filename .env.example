# -----------------------------------------------------------------------------
# Dynamic MCP identity (change these per client/container)
# -----------------------------------------------------------------------------
CLIENT_ID=peltierpro
CLIENT_NAME=Peltier Pro
PROVIDER_NAME=Zen Business Solutions
SERVICE_NAME=ZenBiz PeltierPro Odoo MCP
ACCESS_MODE=read-write-controlled
WEBSITE_URL=https://your-public-host.example.com/mcp
# Leave blank to use the bundled /assets/zenbiz-icon.png route.
ICON_URL=

# Optional comma-separated external addon directories.
# Each addon .py can expose register_tools(...) or register_*_tools(...).
ADDONS_PATH=

# -----------------------------------------------------------------------------
# Odoo
# -----------------------------------------------------------------------------
ODOO_URL=https://your-odoo.example.com
ODOO_DATABASE=your-odoo-database
ODOO_API_KEY=your_odoo_api_key_here

# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------
MCP_PUBLIC_URL=https://your-public-host.example.com
TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT_SECONDS=30
MAX_RESULTS=50
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Odoo-backed MCP OAuth
# -----------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_RESOURCE_SERVER_URL=https://your-public-host.example.com/mcp
AUTH_REQUIRED_SCOPES=odoo.read
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Per-user tool permissions (requires AUTH_ENABLED=true)
# -----------------------------------------------------------------------------
PERMISSIONS_ENABLED=false
PERMISSIONS_FILE=config/permissions.yaml

# Optional example tool in app/addons/example_dynamic.py
EXAMPLE_DYNAMIC_TOOL=false
